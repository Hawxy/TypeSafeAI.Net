<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>.NET client for the TypeSafe AI System One API. Ask typed noul (yes/no), choice, and score questions about text or structured state and get calibrated, confidence-scored answers back.</Description>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TypeSafeAI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

</Project>
